{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"farewell\" ]",
  "redirects": [
    { "source": "/about", "destination": "/", "permanent": true },
    { "source": "/login", "destination": "/", "permanent": true },
    { "source": "/consent", "destination": "/", "permanent": true },
    { "source": "/privacy", "destination": "/", "permanent": true },
    { "source": "/terms", "destination": "/", "permanent": true },
    { "source": "/memories", "destination": "/", "permanent": true },
    { "source": "/gifts", "destination": "/", "permanent": true },
    { "source": "/conversations/:path*", "destination": "/", "permanent": true },
    { "source": "/play/:path*", "destination": "/", "permanent": true },
    { "source": "/settings/:path*", "destination": "/", "permanent": true },
    { "source": "/admin/:path*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://stand.hmhnk.top; media-src 'self' https://stand.hmhnk.top; font-src 'self'; connect-src 'self' https://stand.hmhnk.top; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sounds/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
